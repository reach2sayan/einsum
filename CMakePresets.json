{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Unoptimised, assertions live.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "-O3 -march=native.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer",
      "description": "Everything in the tree instrumented, Boost.Test included.",
      "inherits": "debug",
      "cacheVariables": {
        "EINSUM_SANITIZE": "address"
      }
    },
    {
      "name": "python",
      "displayName": "Release + the Python extension",
      "description": "Builds _einsum against .venv and registers the pytest suite with ctest.",
      "inherits": "release",
      "cacheVariables": {
        "EINSUM_BUILD_PYTHON": "ON",
        "EINSUM_BUILD_BENCHMARKS": "OFF",
        "EINSUM_OPENMP": "ON",
        "Python_ROOT_DIR": "${sourceDir}/.venv",
        "Python_FIND_VIRTUALENV": "ONLY"
      }
    },
    {
      "name": "nuget",
      "displayName": "Release + Debug, library only -- what the NuGet package ships",
      "description": "Ninja Multi-Config, so one configure produces both CRT flavours: a consumer building /MDd needs an import library that matches. Windows and MSVC only. Debug carries no debug information on purpose -- CMAKE_MSVC_DEBUG_INFORMATION_FORMAT is emptied below, which is what keeps the package small and what lets sccache cache the output at all, since it cannot cache a separate PDB. Inherits base rather than release: this is a multi-config tree, where a CMAKE_BUILD_TYPE would be inert.",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release;Debug",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "",
        "EINSUM_BUILD_TESTS": "OFF",
        "EINSUM_BUILD_BENCHMARKS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "python",
      "configurePreset": "python"
    },
    {
      "name": "nuget",
      "configurePreset": "nuget"
    }
  ],
  "testPresets": [
    {
      "name": "tbase",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug",
      "inherits": "tbase",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "tbase",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "inherits": "tbase",
      "configurePreset": "asan"
    },
    {
      "name": "python",
      "inherits": "tbase",
      "configurePreset": "python"
    }
  ]
}
